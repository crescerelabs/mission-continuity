 "policies": {
  "proration": {
   "policy_id": "POL-B-PRO",
   "version": 3,
   "rule": "Mid-cycle upgrade: the new plan is charged price x remaining_days / period_days on an immediate invoice. Unused time on the old plan is issued as an account credit at the same ratio; it is not an invoice line."
  },
  "credits": {
   "policy_id": "POL-B-CRD",
   "version": 2,
   "rule": "Credits auto-apply to the next invoice unless auto-apply is disabled. With auto-apply disabled, unapplied credits older than 30 days must be flagged to the account owner (owner_notified=true) and applied or refunded at the owner's instruction."
  },
  "authorizations": {
   "policy_id": "POL-B-AUTH",
   "version": 1,
   "rule": "An authorization is a temporary hold, not a charge. On capture timeout the gateway retries; the uncaptured authorization is released within 3-5 business days. A released authorization is not refundable: no funds were captured."
  },
  "add_ons": {
   "policy_id": "POL-B-ADD",
   "version": 1,
   "rule": "Add-ons may be added by the owner or any admin seat. Added mid-cycle, they start at the next renewal and are invoiced separately at full monthly price."
  },
  "refunds": {
   "policy_id": "POL-B-REF",
   "version": 1,
   "rule": "Refunds and credit applications require billing-specialist approval. Support agents may not promise a refund before billing review."
  }
 },
